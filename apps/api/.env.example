# Environment Configuration for SupportAI API
PROJECT_NAME="SupportAI Platform"
SECRET_KEY="super-secret-production-encryption-key-change-me"
JWT_SECRET_KEY="super-secret-jwt-signing-key-change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL="postgresql+asyncpg://neondb_owner:password@ep-host/neondb?ssl=require"
REDIS_URL="rediss://default:password@host:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672//"
OPENAI_API_KEY="sk-proj-..."
GROQ_API_KEY="gsk_..."

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

